<?xml version="1.0" encoding="UTF-8"?>
<CPackWiXPatch>
  <CPackWiXFragment Id="#PRODUCT">
    <Property Id="ALLUSERS" Value="1"/>
    <Property Id="ARPSYSTEMCOMPONENT" Value="1"/>
    <Property Id="LEGACY_SUNSHINE_PRESENT" Secure="yes">
      <RegistrySearch Id="SearchLegacySunshine64" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Sunshine" Name="DisplayName" Type="raw" Win64="yes"/>
      <RegistrySearch Id="SearchLegacySunshine32" Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Sunshine" Name="DisplayName" Type="raw"/>
    </Property>
    <Property Id="REMOVEVIRTUALDISPLAYDRIVER" Value="0" Secure="yes"/>
    <Property Id="FACTORYRESET" Value="0" Secure="yes"/>
    <Property Id="INSTALL_SUDOVDA" Value="1" Secure="yes"/>
    <Property Id="INSTALL_VIRTUAL_DISPLAY_DRIVER" Secure="yes"/>
    <Property Id="SKIP_REMOVE_CONFLICTING_PRODUCTS" Value="0" Secure="yes"/>
    <!-- Private execute-sequence readiness bit. Prepare always overwrites it;
         command-line callers cannot opt themselves into installed-payload execution. -->
    <Property Id="AudioPolicyTrustedInstallRoot" Value="0"/>
    <Property Id="AudioPolicyProtectRequired" Value="0"/>
    <Property Id="AudioPolicyFullRemove" Value="0"/>
    <Condition Message="Administrator privileges are required.">Privileged</Condition>
    <Condition Message="Legacy Sunshine must be removed manually before installing Vibepollo. The installer will not elevate a registry-sourced legacy uninstaller.">Installed OR REMOVE OR NOT LEGACY_SUNSHINE_PRESENT</Condition>
    <Property Id="VIGEMBUS_PRESENT">
      <RegistrySearch Id="Search_ViGEmBus_Service64" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\ViGEmBus" Name="DisplayName" Type="raw" Win64="yes"/>
      <RegistrySearch Id="Search_ViGEmBus_Service32" Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\ViGEmBus" Name="DisplayName" Type="raw"/>
    </Property>
    <Feature Id="VibepolloExtras" Title="Vibepollo Components" Level="1" Absent="disallow">
      <ComponentRef Id="CtlStopApolloLegacy"/>
      <ComponentRef Id="ApolloSvc"/>
      <ComponentRef Id="RemoveLegacyApolloUninstallKey"/>
      <ComponentRef Id="Fw_Exceptions"/>
      <ComponentRef Id="StartMenuShortcut"/>
      <ComponentRef Id="SudoVdaRegistryDefaults"/>
      <ComponentRef Id="ArpCustomUninstallEntry"/>
    </Feature>
    <InstallExecuteSequence>
      <!-- Native Binary-table preflight is the authority for UI, quiet,
           bootstrapper, direct msiexec, maintenance, and removal paths. -->
      <Custom Action="PrepareAudioPolicyUpgradeSecurity" Before="RemoveExistingProducts">WIX_UPGRADE_DETECTED</Custom>
      <Custom Action="PrepareAudioPolicyInstallTreeSecurity" After="InstallInitialize">NOT WIX_UPGRADE_DETECTED</Custom>

      <!-- Quiet service/process quiesce occurs only after the authoritative
           native Prepare action has published canonical operation state. -->
      <Custom Action="SetKillProcsQuietImmediate" Before="StopServices">AudioPolicyTrustedInstallRoot = "1" AND ((AudioPolicyProtectRequired = "1" AND (Installed OR WIX_UPGRADE_DETECTED) AND UILevel &lt; 5) OR (AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE))</Custom>
      <Custom Action="KillProcsQuietImmediate" After="SetKillProcsQuietImmediate">AudioPolicyTrustedInstallRoot = "1" AND ((AudioPolicyProtectRequired = "1" AND (Installed OR WIX_UPGRADE_DETECTED) AND UILevel &lt; 5) OR (AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE))</Custom>
      <Custom Action="SetStopSvcQuietImmediate" After="KillProcsQuietImmediate">AudioPolicyTrustedInstallRoot = "1" AND ((AudioPolicyProtectRequired = "1" AND (Installed OR WIX_UPGRADE_DETECTED) AND UILevel &lt; 5) OR (AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE))</Custom>
      <Custom Action="StopSvcQuietImmediate" After="SetStopSvcQuietImmediate">AudioPolicyTrustedInstallRoot = "1" AND ((AudioPolicyProtectRequired = "1" AND (Installed OR WIX_UPGRADE_DETECTED) AND UILevel &lt; 5) OR (AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE))</Custom>

      <!-- Stop service proactively on repair or uninstall -->
      <Custom Action="SetStopSvcQuiet" After="PrepareAudioPolicyInstallTreeSecurity">AudioPolicyTrustedInstallRoot = "1" AND ((AudioPolicyProtectRequired = "1" AND Installed AND UILevel &lt; 5) OR (AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE))</Custom>
      <Custom Action="StopSvcQuiet" After="SetStopSvcQuiet">AudioPolicyTrustedInstallRoot = "1" AND ((AudioPolicyProtectRequired = "1" AND Installed AND UILevel &lt; 5) OR (AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE))</Custom>

      <!-- Start quietly on repair with basic/silent UI -->
      <Custom Action="SetStartSvcQuiet" Before="StartSvcQuiet">Installed AND AudioPolicyProtectRequired = "1" AND AudioPolicyTrustedInstallRoot = "1" AND UILevel &lt; 5</Custom>
      <Custom Action="StartSvcQuiet" Before="InstallFinalize">Installed AND AudioPolicyProtectRequired = "1" AND AudioPolicyTrustedInstallRoot = "1" AND UILevel &lt; 5</Custom>

      <!-- Manual uninstall: process/legacy service cleanup -->
      <Custom Action="SetKillProcsQuiet" After="StopSvcQuiet">AudioPolicyFullRemove = "1" AND AudioPolicyTrustedInstallRoot = "1" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="KillProcsQuiet" After="SetKillProcsQuiet">AudioPolicyFullRemove = "1" AND AudioPolicyTrustedInstallRoot = "1" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="SetRemoveServiceQuiet" After="KillProcsQuiet">AudioPolicyFullRemove = "1" AND AudioPolicyTrustedInstallRoot = "1" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="RemoveServiceQuiet" After="SetRemoveServiceQuiet">AudioPolicyFullRemove = "1" AND AudioPolicyTrustedInstallRoot = "1" AND NOT UPGRADINGPRODUCTCODE</Custom>

      <!-- Transactional install/repair hardening. The rollback action is
           scheduled before the forward action; every original descriptor is
           flushed before the first mutation. No installed payload precedes it. -->
      <Custom Action="RollbackAudioPolicyInstallTreeSecurity" After="InstallFiles">AudioPolicyProtectRequired = "1" AND AudioPolicyTrustedInstallRoot = "1"</Custom>
      <Custom Action="ProtectAudioPolicyInstallTreeSecurity" After="RollbackAudioPolicyInstallTreeSecurity">AudioPolicyProtectRequired = "1" AND AudioPolicyTrustedInstallRoot = "1"</Custom>
      <Custom Action="CommitAudioPolicyInstallTreeSecurity" After="ProtectAudioPolicyInstallTreeSecurity">AudioPolicyProtectRequired = "1" AND AudioPolicyTrustedInstallRoot = "1"</Custom>
      <Custom Action="SetInstallSudovda" After="CommitAudioPolicyInstallTreeSecurity">AudioPolicyProtectRequired = "1" AND AudioPolicyTrustedInstallRoot = "1" AND INSTALL_SUDOVDA = "1"</Custom>
      <Custom Action="InstallSudovda" After="SetInstallSudovda">AudioPolicyProtectRequired = "1" AND AudioPolicyTrustedInstallRoot = "1" AND INSTALL_SUDOVDA = "1"</Custom>
      <Custom Action="SetInstallVirtualDisplayDriver" After="InstallSudovda">AudioPolicyProtectRequired = "1" AND AudioPolicyTrustedInstallRoot = "1" AND INSTALL_VIRTUAL_DISPLAY_DRIVER &lt;&gt; "0"</Custom>
      <Custom Action="InstallVirtualDisplayDriver" After="SetInstallVirtualDisplayDriver">AudioPolicyProtectRequired = "1" AND AudioPolicyTrustedInstallRoot = "1" AND INSTALL_VIRTUAL_DISPLAY_DRIVER &lt;&gt; "0"</Custom>
      <!-- Vibepollo registers the Vulkan HDR layer on every install (SudoVDA needs it too,
           not just the virtual-display driver), so gate it on canonical protect-required state. -->
      <Custom Action="SetRegisterVulkanHdrLayer" After="InstallVirtualDisplayDriver">AudioPolicyProtectRequired = "1" AND AudioPolicyTrustedInstallRoot = "1"</Custom>
      <Custom Action="RegisterVulkanHdrLayer" After="SetRegisterVulkanHdrLayer">AudioPolicyProtectRequired = "1" AND AudioPolicyTrustedInstallRoot = "1"</Custom>
      <!-- Tightened to NOT Installed so repair/upgrade does not rerun install-time migration work. -->
      <Custom Action="SetMigrateConfig" After="RegisterVulkanHdrLayer">NOT Installed AND AudioPolicyProtectRequired = "1" AND AudioPolicyTrustedInstallRoot = "1"</Custom>
      <Custom Action="MigrateConfig" After="SetMigrateConfig">NOT Installed AND AudioPolicyProtectRequired = "1" AND AudioPolicyTrustedInstallRoot = "1"</Custom>
      <Custom Action="SetRunInstallerMigrations" After="MigrateConfig">NOT Installed AND AudioPolicyProtectRequired = "1" AND AudioPolicyTrustedInstallRoot = "1"</Custom>
      <Custom Action="RunInstallerMigrations" After="SetRunInstallerMigrations">NOT Installed AND AudioPolicyProtectRequired = "1" AND AudioPolicyTrustedInstallRoot = "1"</Custom>
      <Custom Action="SetUpdatePathAdd" After="RunInstallerMigrations">AudioPolicyProtectRequired = "1" AND AudioPolicyTrustedInstallRoot = "1"</Custom>
      <Custom Action="UpdatePathAdd" After="SetUpdatePathAdd">AudioPolicyProtectRequired = "1" AND AudioPolicyTrustedInstallRoot = "1"</Custom>

      <!-- Uninstall before file removal -->
      <Custom Action="VerifyAudioPolicyUninstallTreeSecurity" Before="SetRestoreNvPrefsUndo">AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE AND AudioPolicyTrustedInstallRoot = "1"</Custom>
      <Custom Action="SetRestoreNvPrefsUndo" Before="RemoveFiles">AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE AND AudioPolicyTrustedInstallRoot = "1"</Custom>
      <Custom Action="RestoreNvPrefsUndo" After="SetRestoreNvPrefsUndo">AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE AND AudioPolicyTrustedInstallRoot = "1"</Custom>

      <!-- Remove Virtual Display Driver only when explicitly requested by uninstall properties. -->
      <Custom Action="SetUnregisterVulkanHdrLayer" After="RestoreNvPrefsUndo">AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE AND AudioPolicyTrustedInstallRoot = "1"</Custom>
      <Custom Action="UnregisterVulkanHdrLayer" After="SetUnregisterVulkanHdrLayer">AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE AND AudioPolicyTrustedInstallRoot = "1"</Custom>
      <Custom Action="SetUninstallSudovda" After="UnregisterVulkanHdrLayer">AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE AND AudioPolicyTrustedInstallRoot = "1" AND REMOVEVIRTUALDISPLAYDRIVER = "1"</Custom>
      <Custom Action="UninstallSudovda" After="SetUninstallSudovda">AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE AND AudioPolicyTrustedInstallRoot = "1" AND REMOVEVIRTUALDISPLAYDRIVER = "1"</Custom>
      <Custom Action="SetUninstallVirtualDisplayDriver" After="UninstallSudovda">AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE AND AudioPolicyTrustedInstallRoot = "1" AND REMOVEVIRTUALDISPLAYDRIVER = "1"</Custom>
      <Custom Action="UninstallVirtualDisplayDriver" After="SetUninstallVirtualDisplayDriver">AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE AND AudioPolicyTrustedInstallRoot = "1" AND REMOVEVIRTUALDISPLAYDRIVER = "1"</Custom>

      <!-- Factory reset only removes known Vibepollo app data. MSI-owned files are removed by MSI itself. -->
      <Custom Action="SetFactoryResetAppData" After="UninstallVirtualDisplayDriver">AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE AND AudioPolicyTrustedInstallRoot = "1" AND (FACTORYRESET = "1" OR DELETEINSTALLDIR = "1")</Custom>
      <Custom Action="FactoryResetAppData" After="SetFactoryResetAppData">AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE AND AudioPolicyTrustedInstallRoot = "1" AND (FACTORYRESET = "1" OR DELETEINSTALLDIR = "1")</Custom>

      <!-- After MSI has removed its tracked files, remove the install root only if it is empty. -->
      <Custom Action="SetCleanupEmptyInstallRoot" After="RemoveFiles">AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE AND AudioPolicyTrustedInstallRoot = "1"</Custom>
      <Custom Action="CleanupEmptyInstallRoot" After="SetCleanupEmptyInstallRoot">AudioPolicyFullRemove = "1" AND NOT UPGRADINGPRODUCTCODE AND AudioPolicyTrustedInstallRoot = "1"</Custom>
    </InstallExecuteSequence>

    <InstallUISequence>
      <Custom Action="RepairCompletePrompt" After="ExecuteAction">REINSTALL AND NOT REMOVE AND NOT UPGRADINGPRODUCTCODE AND UILevel &gt; 2</Custom>
    </InstallUISequence>
  </CPackWiXFragment>
</CPackWiXPatch>
